# 智谱开放平台 API Key（必填，仅服务端读取）
# 获取地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=

# 图像生成模型 ID（默认 cogview-3-flash）
IMAGE_MODEL=cogview-3-flash

# 智谱 API 基地址（可切换国际端点）
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 下载代理主机白名单（逗号分隔，追加语义：默认域名始终放行，这里只补充额外域名）
# 智谱 CogView 返回的图片域名 sfile.chatglm.cn 等已内置，通常无需配置
DOWNLOAD_HOST_ALLOWLIST=
